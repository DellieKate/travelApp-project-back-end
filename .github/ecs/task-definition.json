{
    "containerDefinitions": [
        {
            "name": "travelapp-container",
            "image": "304619557163.dkr.ecr.ap-southeast-2.amazonaws.com/travel-backend",
            "memoryReservation": 1536,
            "memory": 2048,
            "essential": true,
            "dependsOn":[
                {
                    "containerName" : "mongodb",
                    "condition" : "HEALTHY"
                }
            ],
            "portMappings": [
                {
                    "name": "travelapp-container-3000-tcp",
                    "containerPort": 3000,
                    "hostPort": 3000,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "environment": [
                {
                    "name": "NODE_ENV",
                    "value": "production"
                },
                {
                    "name": "PORT",
                    "value": "3000"
                },
                {
                    "name": "JWT_SECRET",
                    "value": "CoderAcademyCharliInnaKate"
                },
                {
                    "name": "MONGO_URL_TEST",
                    "value": "mongodb://127.0.0.1:27017/travelApp_test"
                },
                {
                    "name": "MONGO_URL_DEV",
                    "value": "mongodb://localhost:27017/travelApp-project-backend"
                },
                {
                    "name": "MONGO_URL_PROD",
                    "value": "mongodb://localhost:27017/travelApp-project-backend"
                },
                {
                    "name": "MONGO_URL",
                    "value": "mongodb+srv://katem_db_user:Sblnz0GJlSJ1vq3w@cluster0.elmox5y.mongodb.net/travelApp-project-backend"
                }
            ],
            "healthCheck" : {
                "command": [
                    "CMD-SHELL", 
                    "node -e \"require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
                ],
                "interval": 30,
                "timeout": 10,
                "retries": 3,
                "startPeriod": 60
            },
            "environmentFiles": [],
            "mountPoints": [],
            "volumesFrom": [],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/travelapp-task",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-southeast-2",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ],
    "family": "travelapp-task",
    "executionRoleArn": "arn:aws:iam::304619557163:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "2048",
    "memory": "6144",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "tags": []
}